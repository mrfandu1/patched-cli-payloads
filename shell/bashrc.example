# Termux shell setup for the patched CLIs.
#
# Deliberately no proxy exports here. The loopback CONNECT proxy exists only for
# the musl-linked CLIs (claude, opencode, codex), whose libc reads the absolute
# /etc/resolv.conf that Android does not provide. Each wrapper sets the proxy for
# its own process, so curl, npm, git and everything else in this shell keep
# talking to the network directly. Exporting it here instead would route every
# command through 127.0.0.1:18080 and break them whenever the supervisor is down.

export SSL_CERT_FILE="${SSL_CERT_FILE:-$PREFIX/etc/tls/cert.pem}"
export DISABLE_AUTOUPDATER=1
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Keep API keys in your untracked ~/.bashrc or a credential manager.
