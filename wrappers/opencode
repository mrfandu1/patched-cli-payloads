#!/data/data/com.termux/files/usr/bin/bash
# opencode.exe is musl-linked and cannot resolve DNS on Android for the same
# reason as claude — see wrappers/claude. The proxy is scoped to this process.
unset LD_PRELOAD
export HTTP_PROXY=http://127.0.0.1:18080
export HTTPS_PROXY=http://127.0.0.1:18080
export NO_PROXY=localhost,127.0.0.1
export SSL_CERT_FILE="${SSL_CERT_FILE:-${PREFIX:-/data/data/com.termux/files/usr}/etc/tls/cert.pem}"
if [ -x "$HOME/bin/ensure-local-proxy.sh" ]; then
  "$HOME/bin/ensure-local-proxy.sh" >/dev/null 2>&1
fi
exec "${PREFIX:-/data/data/com.termux/files/usr}/lib/node_modules/opencode-ai/bin/opencode.exe" "$@"
