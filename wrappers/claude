#!/data/data/com.termux/files/usr/bin/bash
# claude is musl-linked. musl resolves DNS through the absolute /etc/resolv.conf,
# which Android does not provide and which cannot be created without root, so the
# binary cannot look up api.anthropic.com on its own. Scope the loopback CONNECT
# proxy to this process instead of exporting it shell-wide: here it is required,
# while curl/npm (bionic) resolve natively and must stay direct.
unset LD_PRELOAD
export DISABLE_AUTOUPDATER=1
export HTTP_PROXY=http://127.0.0.1:18080
export HTTPS_PROXY=http://127.0.0.1:18080
export NO_PROXY=localhost,127.0.0.1
export SSL_CERT_FILE="${SSL_CERT_FILE:-${PREFIX:-/data/data/com.termux/files/usr}/etc/tls/cert.pem}"
if [ -x "$HOME/bin/ensure-local-proxy.sh" ]; then
  "$HOME/bin/ensure-local-proxy.sh" >/dev/null 2>&1
fi
exec "$HOME/.local/share/claude-termux/claude" "$@"
